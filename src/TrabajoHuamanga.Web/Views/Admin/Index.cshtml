@model List<CalificacionDto>
@{
    ViewData["Title"] = "Panel de Administración";
}

<h3 class="mb-4">
    <i class="fas fa-shield-alt me-2 text-primary"></i>Panel de Administración
</h3>

<!-- Estadísticas -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card profesionales">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-0 text-white-50">Profesionales Activos</p>
                    <h3>@ViewBag.TotalProfesionales</h3>
                </div>
                <i class="fas fa-users fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card reportadas">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-0 text-white-50">Calificaciones Reportadas</p>
                    <h3>@ViewBag.TotalReportadas</h3>
                </div>
                <i class="fas fa-flag fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background:linear-gradient(135deg,#059669,#10b981);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-0 text-white-50">Estado del Sistema</p>
                    <h3>Activo</h3>
                </div>
                <i class="fas fa-check-circle fa-2x text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Calificaciones reportadas -->
<div class="card card-profesional">
    <div class="card-body">
        <h5 class="mb-3">
            <i class="fas fa-flag me-2 text-danger"></i>Calificaciones Reportadas para Revisión
        </h5>

        @if (Model.Count == 0)
        {
            <div class="text-center py-4">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <p class="text-muted">No hay calificaciones reportadas. ¡Todo en orden!</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Puntaje</th>
                            <th>Comentario</th>
                            <th>Motivo Reporte</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cal in Model)
                        {
                            <tr>
                                <td><strong>@cal.NombreUsuario</strong></td>
                                <td>
                                    <div class="stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fas fa-star@(i <= cal.Puntaje ? "" : " empty")" style="font-size:0.8rem;"></i>
                                        }
                                    </div>
                                </td>
                                <td class="small">@cal.Comentario</td>
                                <td class="small text-danger">
                                    <i class="fas fa-exclamation-triangle me-1"></i>@cal.MotivoReporte
                                </td>
                                <td class="small">@cal.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <form asp-action="Ocultar" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@cal.Id" />
                                        <button class="btn btn-sm btn-danger" title="Ocultar">
                                            <i class="fas fa-eye-slash"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Restaurar" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="id" value="@cal.Id" />
                                        <button class="btn btn-sm btn-success" title="Restaurar">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
