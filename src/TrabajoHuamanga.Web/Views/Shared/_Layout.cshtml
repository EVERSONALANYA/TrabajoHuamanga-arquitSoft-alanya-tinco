<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trabajo Huamanga</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="fas fa-briefcase me-2"></i>Trabajo Huamanga</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-search me-1"></i>Buscar</a></li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Profesional") || User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Profesional" asp-action="Registrar"><i class="fas fa-user-plus me-1"></i>Registrar Profesional</a></li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fas fa-shield-alt me-1"></i>Admin</a></li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-user-circle me-1"></i>@User.Identity.Name <span class="badge bg-light text-primary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><form method="post" asp-controller="Cuenta" asp-action="Logout"><button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesion</button></form></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login"><i class="fas fa-sign-in-alt me-1"></i>Ingresar</a></li>
                        <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm ms-2 px-3" asp-controller="Cuenta" asp-action="Registrar"><i class="fas fa-user-plus me-1"></i>Crear Cuenta</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-3">
        @if (TempData["Mensaje"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Mensaje"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    </div>
    <main class="container py-4">@RenderBody()</main>
    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1"><i class="fas fa-briefcase me-2"></i>Trabajo Huamanga</p>
            <p class="text-muted small mb-0">Directorio de profesionales de servicios en Huamanga, Ayacucho</p>
            <p class="text-muted small">IS-488 Arquitectura de Software - UNSCH 2024</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
